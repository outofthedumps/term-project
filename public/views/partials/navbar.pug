nav.site-navbar(aria-label="Main navigation")
    a.brand(href="/" aria-label="Home")
        img.logo(src="/images/history-showroom-logo.png" alt="Site Logo")
        span.site-name History Showroom

    a.nav-link(href="/about") about
    a.nav-link(href="/faq") FAQ

    input.search-field(type="search" name="q" placeholder="Search" aria-label="Search")

    a.icon-link(href="/cart" aria-label="Shopping cart")
        svg.icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
            path(d="M2 3h3l3 12h11l3-8H6")
            circle(cx="9" cy="20" r="1.5")
            circle(cx="18" cy="20" r="1.5")

    a.icon-link(href="/profile" aria-label="User profile")
        svg.icon(viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")
            circle(cx="12" cy="7" r="4")
            path(d="M4 21v-2a8 8 0 0 1 16 0v2")