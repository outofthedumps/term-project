extends layout

include partials/product-card.pug

block content
  section.home-graphic(aria-label="History Showroom graphic")
    img(
      src="/images/Washington-home-graphic.png"
      alt="History Showroom logo featuring George Washington as a historical relic dealer"
    )

  section.featured-section(aria-labelledby="featured-heading")
    header.featured-header
      h1#featured-heading Featured Relics
      a.featured-view-all(href="/shop")
        | View all relics
        span(aria-hidden="true") ↗

    .featured-items
      each item in featuredItems
        +productCard(item)
      else
        p.featured-empty No featured items are available yet.